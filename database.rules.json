{
  "rules": {
    "matches": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "lobbies": {
      ".read": "auth != null",
      "$roomCode": {
        ".write": "auth != null"
      }
    },

    "activeGames": {
      ".read": true,
      "$roomCode": {
        ".write": "auth != null"
      }
    },

    "cards": {
      ".read": true,
      "$cardNumber": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['cardNumber', 'name'])"
      }
    },

    "cardIndex": {
      ".read": true,
      "$cardNumber": {
        ".write": "auth != null"
      }
    },

    "collections": {
      ".read": true,
      "$slug": {
        ".write": "auth != null"
      }
    }
  }
}
